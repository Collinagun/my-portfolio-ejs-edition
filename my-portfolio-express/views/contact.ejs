<%- include('partials/header') %>

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg border-0" style="border-radius: 15px;">
            <div class="card-body p-5">
                <h2 class="section-title mb-4" style="color: var(--primary-purple);">Contact Me</h2>
                <p class="text-center text-muted mb-4">Don't miss to contact me for more information, kindly fill the form below.</p>
                
                <form action="mailto:collin.chiong@ontariotechu.net?subject=Feedback" method="post" enctype="text/plain" name="Feedback_form">
                    
                    <div class="input-group mb-3 shadow-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" id="fname" name="fname" placeholder="First & Last Name" required>
                    </div>

                    <div class="input-group mb-3 shadow-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                        <input type="email" class="form-control border-start-0" id="email" name="email" placeholder="Your Email" required>
                    </div>

                    <div class="input-group mb-3 shadow-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-phone text-muted"></i></span>
                        <input type="tel" class="form-control border-start-0" id="phone" name="phone" placeholder="123-456-7890" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" required>
                    </div>

                    <div class="input-group mb-3 shadow-sm">
                        <span class="input-group-text bg-white border-end-0" style="align-items: flex-start; padding-top: 10px;"><i class="fa-solid fa-comment text-muted"></i></span>
                        <textarea class="form-control border-start-0" id="comments" name="comments" rows="4" placeholder="Your Message" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="where" class="form-label text-muted small">How did you find me?</label>
                        <select class="form-select shadow-sm" name="where" id="where">
                            <option value="Search engine">Search Engine</option>
                            <option value="Social Media">Social Media</option>
                            <option value="Word of mouth">Word of mouth</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    
                    <fieldset class="mb-4">
                        <legend class="form-label text-muted small">Did you like my webpage?</legend>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="Yradio" name="rating" value="Yes">
                            <label class="form-check-label" for="Yradio">Yes</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" id="Nradio" name="rating" value="No">
                            <label class="form-check-label" for="Nradio">No</label>
                        </div>
                    </fieldset>
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn text-white shadow" style="background-color: var(--primary-teal);"><i class="fa-solid fa-paper-plane"></i> SEND</button>
                        <button type="reset" class="btn btn-outline-secondary">Reset</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>