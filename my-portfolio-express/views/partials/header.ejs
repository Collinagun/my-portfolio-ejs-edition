<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Collin Chiong</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- Custom CSS matching the sample layout but using YOUR colors -->
    <style>
        :root {
            --primary-orange: #D99437;
            --primary-teal: #23B7D9;
            --primary-green: #1FA65A;
            --primary-cream: #F2E2CE;
            --primary-purple: #8176D7;
            --dark-bg: #2b2b2b;
        }

        body {
            background-color: var(--primary-cream);
            font-family: 'JetBrains Mono', monospace;
            color: #101010;
        }

        /* Navigation */
        .navbar-custom {
            background-color: var(--dark-bg);
        }
        .navbar-custom .nav-link {
            color: #ffffff;
        }
        .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active {
            color: var(--primary-teal) !important;
        }

        /* Hero Banner */
        .hero-section {
            background: linear-gradient(135deg, var(--primary-purple) 0%, var(--primary-teal) 100%);
            color: white;
            border-radius: 15px;
            padding: 40px;
            margin-top: 20px;
        }
        .profile-pic-hero {
            width: 150px;
            height: 150px;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid white;
        }
        .hero-section a { color: white; text-decoration: none; }
        .hero-section a:hover { color: var(--primary-cream); }

        /* Section Titles */
        .section-title {
            color: var(--primary-purple);
            font-weight: bold;
            text-align: center;
            margin-bottom: 30px;
        }

        /* Project Cards */
        .card-container {
            background-color: var(--dark-bg);
            border-radius: 15px;
            padding: 30px;
        }
        .project-card {
            border: none;
            border-radius: 10px;
            background-color: #ffffff;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            transition: transform 0.2s;
            height: 100%;
        }
        .project-card:hover {
            transform: translateY(-5px);
        }
        .tech-badge {
            background-color: #333;
            color: white;
            font-size: 0.75rem;
            padding: 3px 8px;
            border-radius: 4px;
            margin: 2px;
            display: inline-block;
        }

        /* Footer */
        .footer-custom {
            background-color: var(--primary-purple);
            color: #ffffff;
            padding: 40px 0;
            margin-top: 50px;
        }
        .footer-custom a { color: #ffffff; text-decoration: none; }
        .footer-custom a:hover { color: var(--primary-cream); }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand text-white" href="/"><i class="fa-solid fa-code"></i> Collin Chiong</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link <%= title === 'Home' ? 'active' : '' %>" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link <%= title === 'About' ? 'active' : '' %>" href="/about">About</a></li>
                    <li class="nav-item"><a class="nav-link <%= title === 'Projects' ? 'active' : '' %>" href="/projects">Projects</a></li>
                    <li class="nav-item"><a class="nav-link <%= title === 'Contact' ? 'active' : '' %>" href="/contact">Contact</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container pb-5">